---
import ContactForm from "../form/contact-form"
import { companyDetails } from "../../data/company-details";
const { email: contactEmail, phone: contactPhone, socialLinks } = companyDetails;

const expectations = [
  "Typical response: 24-48 hours",
  "Best for: SaaS, web apps, product teams",
  "We'll ask about goals, constraints, timeline",
  "If we're not a fit, we'll say so",
];
---
    <section class="relative overflow-hidden bg-white py-24 lg:py-32">
      <div class="grid-bg absolute inset-0 opacity-30"></div>
      <div class="absolute right-0 top-0 h-full w-1/2 bg-linear-to-l from-primary/5 to-transparent"></div>
      <div class="relative z-10 mx-auto w-full max-w-360 px-8 lg:px-12">
        <div class="max-w-4xl">
          <p class="mb-6 text-sm font-bold uppercase tracking-widest text-primary">Contact</p>
          <h1 class="text-balance mb-8 text-6xl font-extrabold leading-none text-neutral-950 lg:text-8xl">Let's talk.</h1>
          <p class="max-w-2xl text-xl leading-relaxed text-neutral-500">
            Tell us what you're building. We'll respond with clear next steps, no fluff.
          </p>
          <p
            class="mt-10 inline-flex items-center gap-3 rounded-full border border-neutral-200 bg-white/70 px-4 py-2 text-xs font-bold uppercase tracking-widest text-neutral-500"
          >
            <span class="size-1.5 animate-pulse rounded-full bg-primary"></span>
            Response within 24-48 hours
          </p>
        </div>
      </div>
    </section>

     <section class="border-y border-neutral-100 bg-neutral-50 py-24 lg:py-32" id="contact-form">
      <div class="mx-auto max-w-360 px-8 lg:px-12">
        <div class="grid items-start gap-12 lg:grid-cols-12 lg:items-stretch">
          <div class="lg:col-span-7">
            <h2 class="text-4xl font-extrabold leading-tight text-neutral-950 lg:text-5xl">Share the project context.</h2>
            <p class="mt-6 max-w-xl text-lg text-neutral-500">
              The more specific you are about goals and constraints, the faster we can propose the right path.
            </p>
            <ContactForm client:load/>            
          </div>

          <aside class="lg:col-span-5 lg:h-full">
            <div class="h-full border border-neutral-200 bg-white p-10 lg:p-12">
              <h3 class="mb-8 text-3xl font-extrabold text-neutral-950">Contact details</h3>
              <ul class="space-y-8">
                <li>
                  <h4 class="mb-3 text-xs font-bold uppercase tracking-widest text-neutral-950">Email</h4>
                  <a class="text-base text-neutral-500 transition-colors hover:text-primary" href={`mailto:${contactEmail}`}>
                    {contactEmail}
                  </a>
                </li>
                <li>
                  <h4 class="mb-3 text-xs font-bold uppercase tracking-widest text-neutral-950">Phone</h4>
                  <p class="text-base text-neutral-500">{contactPhone}</p>
                </li>
                <li>
                  <h4 class="mb-3 text-xs font-bold uppercase tracking-widest text-neutral-950">Social</h4>
                  <div class="flex flex-wrap gap-6">
                    {
                      socialLinks.map((link) => (
                        <a
                          class="text-xs font-extrabold uppercase tracking-widest text-neutral-400 transition-colors hover:text-primary"
                          href={link.href}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {link.label}
                        </a>
                      ))
                    }
                  </div>
                </li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white py-24 lg:py-32">
      <div class="mx-auto max-w-360 px-8 lg:px-12">
        <div class="max-w-3xl">
          <p class="mb-6 text-sm font-bold uppercase tracking-widest text-primary">Before we start</p>
          <h2 class="mb-12 text-5xl font-extrabold leading-tight text-neutral-950">What to expect.</h2>
        </div>
        <ul class="grid gap-6 md:grid-cols-2">
          {
            expectations.map((item) => (
              <li class="flex items-start gap-4 border border-neutral-200 bg-neutral-50 px-6 py-5">
                <span aria-hidden="true" class="mt-1.5 size-2 rounded-full bg-primary"></span>
                <span class="text-base text-neutral-600">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
