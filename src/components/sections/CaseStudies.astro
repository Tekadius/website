    image:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuAmKS1baUpGtd4gLjJL35V9DTvFAbyx0aFoob7ISMDj9mjoojGJbIuACaIshXPIKG8c8rSjPqQl7JeZ7t0dKB7PFAsdHrgf78z3McPwPYPNf_QbezLoxLzaml-fDzK1USLVOjJMFIyUpDB6MprCIqIdvcQk1YvM2NUWcJYDmzOWzbYDLLDIScaHdVr79tzLYgsPb9ccTMiSCxP3oD0tc0i-ohQoS1JIG-oT12cuhBeARcjppSZBdQvNDZe26edtIPgYFCkazdv5hWj3",
    tags: ["Fintech", "Product Design", "2024"],
    title: "Nexus Core Banking",
  },
  {
    description:
      "Designing and building a high-fidelity data visualization platform for enterprise logistics firms globally.",
    image:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuCbGz8vwUeA9WdXr0eqC7oo-gkXDDa5FdsLtxHR7tJb3Jt--HLNMDxImIgPIPLWqG_TsTHQJWh9qNHnWhSe91VxDcjWIFRjHsFl864_x90pl1BxyPZaOPnNiTKoSdBfVez7GOWY6ukWrdEY5Cp_6wF2qAGs7vU3trvMO6OwMk98xepwYLCWQkqQ4CQAUlYIyi1NqbZkkhpVG-UdLfRpHMxvTmgjQQXBIBd8KJYFaj6w9VeY2rWa-mWiUJaVGv3QCF1UASKcVCA0XMeA",
    tags: ["SaaS", "Engineering", "2023"],
    title: "Lumina Analytics",
  },
];
---

<section class="bg-neutral-950 py-32 text-white" id="case-studies">
  <div class="mx-auto max-w-360 px-8 lg:px-12">
    <div class="mb-24 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="mb-6 text-[13px] font-bold uppercase tracking-[0.3em] text-primary">Recent Work</p>
        <h2 class="text-5xl font-extrabold lg:text-7xl">Selected Projects.</h2>
      </div>
      <a class="border-b-2 border-primary pb-2 text-sm font-bold uppercase tracking-widest" href="#contact">
        View Portfolio
      </a>
    </div>
    <div class="space-y-32">
      {
        caseStudies.map((study) => (
          <article class="group cursor-pointer">
            <div class="relative mb-10 aspect-21/9 overflow-hidden rounded-sm bg-neutral-900">
              <img
                alt={study.title}
                class="h-full w-full object-cover grayscale transition-all duration-1000 group-hover:scale-105 group-hover:grayscale-0"
                loading="lazy"
                src={study.image}
              />
              <div class="absolute inset-0 bg-neutral-950/20 transition-colors group-hover:bg-transparent"></div>
            </div>
            <div class="flex flex-col items-start justify-between gap-6 md:flex-row">
              <div>
                <h3 class="mb-4 text-4xl font-bold">{study.title}</h3>
                <div class="flex gap-4 text-[11px] font-bold uppercase tracking-widest text-neutral-500">
                  {
                    study.tags.map((tag, index) => (
                      <span class={index === 1 ? "flex items-center" : undefined}>
                        {tag}
                        {index < study.tags.length - 1 && <span class="ml-4 mt-1.5 size-1 rounded-full bg-neutral-700"></span>}
                      </span>
                    ))
                  }
                </div>
              </div>
              <p class="max-w-md text-lg leading-relaxed text-neutral-400">{study.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
