---

<header class="relative flex items-center overflow-hidden bg-white pt-10">
  <div class="grid-bg absolute inset-0 opacity-40"></div>
  <div class="absolute right-0 top-0 h-full w-1/2 bg-linear-to-l from-primary/5 to-transparent"></div>
  <div class="relative z-10 mx-auto w-full max-w-360 px-8 py-20 lg:px-12 lg:py-32">
    <div class="max-w-5xl">
      <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-neutral-200 bg-white/50 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-neutral-500">
        <span class="size-1.5 animate-pulse rounded-full bg-primary"></span>
        Digital Craftsmanship Studio
      </div>
      <h1 class="text-balance mb-10 text-6xl font-extrabold leading-[0.95] text-neutral-950 lg:text-[110px]">
        We engineer digital products that
        <span aria-hidden="true" class="hero-word-rotator italic text-primary">
          <span class="hero-word-track">
            <span>scale</span>
            <span>secure</span>
            <span>endure</span>
            <span>scale</span>
          </span>
        </span>
        <span class="sr-only">perform</span>
      </h1>
      <div class="mt-16 flex flex-col gap-10 md:flex-row md:items-center">
        <p class="max-w-md text-xl font-normal leading-relaxed text-neutral-500">
          We design and build high-performance web products for brands that care about quality, scalability, and
          long-term impact.
        </p>
        <div class="flex flex-wrap gap-5">
          <a
            class="rounded-full bg-neutral-950 px-10 py-5 text-sm font-bold uppercase tracking-widest text-white transition-transform hover:scale-105"
            href="/contact"
          >
            Start a Project
          </a>
          <div class="flex items-center -space-x-3">
            {
              avatarImages.map((src, index) => (
                <div class="size-10 overflow-hidden rounded-full border-2 border-white bg-neutral-200">
                  <img alt={`User ${index + 1}`} loading="lazy" src={src} />
                </div>
              ))
            }
            <span class="ml-6 text-sm font-bold text-neutral-400">Trusted by 50+ Leaders</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-word-rotator {
    display: inline-block;
    min-width: fit-content;
    padding-right: 0.1em;
    height: 0.9em;
    overflow: hidden;
    vertical-align: baseline;
  }

  .hero-word-track {
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    animation: hero-word-slide 6.9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform;
  }

  .hero-word-track > span {
    display: block;
    height: 1em;
  }

  @keyframes hero-word-slide {
    0%,
    23.19% {
      transform: translateY(0);
    }

    33.33%,
    56.52% {
      transform: translateY(-1em);
    }

    66.67%,
    89.86% {
      transform: translateY(-2em);
    }

    100% {
      transform: translateY(-3em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word-track {
      animation: none;
      transform: none;
    }
  }
</style>
