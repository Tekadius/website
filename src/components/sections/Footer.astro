---
import Logo from "../../assets/tekadius_logo.svg";
import { companyDetails } from "../../data/company-details";
const currentYear = new Date().getFullYear();
const isHomePage = Astro.url.pathname === "/";
const sectionHref = (id: string) => (isHomePage ? `#${id}` : `/#${id}`);
const topHref = isHomePage ? "#top" : "/";
const { email, phone, socialLinks } = companyDetails;

const platformLinks = [
  { href: sectionHref("services"), label: "Services" },
  { href: topHref, label: "Our Story" },
  { href: sectionHref("case-studies"), label: "Case Studies" },
  { href: "/contact", label: "Contact" },
];

const specialtyLinks = ["Web Apps", "SaaS UX", "DevOps", "Branding"];
---

<footer class="border-t border-neutral-100 bg-neutral-50 py-24 lg:py-32" id="contact">
  <div class="mx-auto max-w-360 px-8 lg:px-12">
    <div class="mb-24 grid grid-cols-1 gap-20 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a class="mb-8 flex items-center gap-2" href={topHref}>
          <img src={Logo.src} alt="Tekadius Logo" class="h-8 w-auto" />
        </a>
        <p class="mb-10 text-2xl font-bold leading-snug text-neutral-950">
          Building calm, scalable digital systems for teams that care about quality.
        </p>
        <div class="flex gap-8">
          {
            socialLinks.map((link) => (
              <a
                class="text-xs font-extrabold uppercase tracking-widest text-neutral-400 transition-colors hover:text-primary"
                href={link.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="grid grid-cols-2 gap-12 lg:col-span-7 md:grid-cols-3">
        <div>
          <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-neutral-950">Platform</h2>
          <ul class="space-y-4">
            {
              platformLinks.map((link) => (
                <li>
                  <a class="text-sm text-neutral-500 hover:text-primary" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-neutral-950">Specialties</h2>
          <ul class="space-y-4">
            {
              specialtyLinks.map((link) => (
                <li class="text-sm text-neutral-500">{link}</li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-neutral-950">Hello</h2>
          <ul class="space-y-4">
            <li>
              <a class="text-sm text-neutral-500 hover:text-primary" href={`mailto:${email}`}>
                {email}
              </a>
            </li>
            <li class="text-sm text-neutral-500">{phone}</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-6 border-t border-neutral-200 pt-12 md:flex-row">
      <p class="text-xs font-bold uppercase tracking-widest text-neutral-400">
        &copy; {currentYear} Tekadius. All rights reserved.
      </p>
      <div class="flex gap-8">
        <a class="text-xs font-bold uppercase tracking-widest text-neutral-400 hover:text-primary" href="/privacy">
          Privacy
        </a>
        <a class="text-xs font-bold uppercase tracking-widest text-neutral-400 hover:text-primary" href="/terms">
          Terms
        </a>
      </div>
    </div>
  </div>
</footer>
