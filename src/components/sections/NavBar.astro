---
import Logo from "../../assets/tekadius_logo.svg"

const isHomePage = Astro.url.pathname === "/";
const sectionHref = (id: string) => (isHomePage ? `#${id}` : `/#${id}`);
const logoHref = isHomePage ? "#top" : "/";
---

<nav class="glass-nav fixed top-0 z-100 w-full border-b border-neutral-100 bg-white/70">
  <div class="mx-auto flex h-20 max-w-360 items-center justify-between px-8 lg:px-12">
    <div class="flex items-center gap-8">
      <a class="flex items-center gap-2" href={logoHref}>
        <img src={Logo.src} alt="Tekadius Logo" class="h-8 w-auto" loading="eager" decoding="sync"/>
      </a>
      <div class="ml-12 hidden items-center gap-8 md:flex">
        <a
          class="text-sm font-semibold uppercase tracking-widest text-neutral-500 transition-colors hover:text-primary"
          href={sectionHref("services")}
        >
          Services
        </a>
        <a
          class="text-sm font-semibold uppercase tracking-widest text-neutral-500 transition-colors hover:text-primary"
          href={sectionHref("process")}
        >
          Process
        </a>
        <a
          class="text-sm font-semibold uppercase tracking-widest text-neutral-500 transition-colors hover:text-primary"
          href={sectionHref("case-studies")}
        >
          Work
        </a>
      </div>
    </div>
    <div class="flex items-center gap-6">
      <a class="hidden text-sm font-bold text-neutral-950 lg:block" href="/contact">Let's Talk</a>
      <a
        class="rounded-full bg-primary px-7 py-3 text-sm font-bold uppercase tracking-widest text-white transition-all hover:bg-blue-700"
        href="/contact"
      >
        Contact
      </a>
    </div>
  </div>
</nav>
