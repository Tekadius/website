---
const services = [
  {
    description: "Performance is not an optimization phase - it's the foundation.",
    icon: "terminal",
    title: "Engineering",
  },
  {
    description: "Beautiful interfaces mean nothing if users hesitate.",
    icon: "auto_awesome",
    title: "Experience",
  },
  {
    description: "Scale is planned - not survived.",
    icon: "cloud",
    title: "Scale",
  },
  {
    description: "Growth without clarity is just noise.",
    icon: "ads_click",
    title: "Growth",
  },
];
---

<section class="border-y border-neutral-100 bg-neutral-50 py-32" id="services">
  <div class="mx-auto max-w-360 px-8 lg:px-12">
    <div class="mb-24 flex flex-col items-start justify-between gap-12 lg:flex-row">
      <div class="max-w-2xl">
        <p class="mb-6 text-[13px] font-bold uppercase tracking-[0.3em] text-primary">Expertise</p>
        <h2 class="text-5xl font-extrabold leading-tight text-neutral-950 lg:text-6xl">
          Capabilities built for products that must last.
        </h2>
      </div>
      <div class="lg:pt-16">
        <p class="max-w-sm text-lg text-neutral-500">
          We take responsibility for complexity, from early decisions to production systems - so growth doesn't come at
          the cost of stability.
        </p>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="group relative overflow-hidden border border-neutral-200 bg-white p-10 transition-all duration-500 hover:border-primary">
            <div class="relative z-10">
              <span class="material-symbols-outlined mb-12 block text-4xl text-neutral-300 transition-colors group-hover:text-primary">
                {service.icon}
              </span>
              <h3 class="mb-4 text-2xl font-bold">{service.title}</h3>
              <p class="mb-8 text-sm leading-relaxed text-neutral-500">{service.description}</p>
              <a
                class="inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-widest text-primary opacity-0 transition-opacity group-hover:opacity-100"
                href="/contact"
              >
                View Details <span class="material-symbols-outlined text-sm">east</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
