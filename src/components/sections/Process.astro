---
const steps = [
  {
    description:
      "We audit your product, infrastructure, and workflows to uncover friction, constraints, and hidden technical debt.",
    number: "01",
    opinionLine: "Assumptions are challenged early - before they become expensive mistakes.",
    title: "Deep Discovery",
  },
  {
    description:
      "We craft high-fidelity interfaces and design systems that balance usability, performance, and long-term maintainability.",
    number: "02",
    opinionLine: "Every decision is tied to real user behavior and business outcomes.",
    title: "Strategic Design",
  },
  {
    description:
      "We build in focused sprints with constant alignment, prioritizing performance, accessibility, and maintainable code.",
    number: "03",
    opinionLine: "Shipping fast matters - shipping well matters more.",
    title: "Agile Engineering",
  },
  {
    description:
      "Post-deployment, we monitor performance, usage, and stability, refining the system to support growth without disruption.",
    number: "04",
    opinionLine: "Scaling should feel controlled - not reactive.",
    title: "Launch & Scale",
  },
];
---

<section class="bg-white py-32" id="process">
  <div class="mx-auto max-w-360 px-8 lg:px-12">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:sticky lg:top-32 lg:h-fit">
        <p class="mb-6 text-[13px] font-bold uppercase tracking-[0.3em] text-primary">Our Methodology</p>
        <h2 class="mb-10 text-5xl font-extrabold leading-tight text-neutral-950">How we reduce risk and build with intent.</h2>
        <p class="mb-12 max-w-sm text-lg text-neutral-500">
          A disciplined, four-phase process designed to reduce risk, sharpen decisions, and deliver systems that scale
          with confidence.
        </p>
        <a class="group flex items-center gap-4 text-sm font-bold uppercase tracking-widest" href="#case-studies">
          <span class="flex size-12 items-center justify-center rounded-full border border-neutral-200 transition-all group-hover:border-primary group-hover:bg-primary group-hover:text-white">
            <span class="material-symbols-outlined text-sm">arrow_downward</span>
          </span>
          See the workflow
        </a>
      </div>
      <div class="space-y-32 lg:col-span-7">
        {
          steps.map((step) => (
            <article class="group flex gap-10">
              <span class="text-6xl font-extrabold text-neutral-100 transition-colors group-hover:text-primary/10">
                {step.number}
              </span>
              <div class="pt-2">
                <h3 class="mb-6 text-3xl font-bold">{step.title}</h3>
                <p class="mb-3 text-lg leading-relaxed text-neutral-500">{step.description}</p>
                <p class="font-semibold italic">{step.opinionLine}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
